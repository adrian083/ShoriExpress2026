# Copia este archivo como .env y sustituye los valores reales en tu entorno.
# NUNCA subas .env a GitHub (contiene secretos).

USE_SQLITE=true
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (solo si USE_SQLITE=false)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=shori_express
MYSQL_USER=root
MYSQL_PASSWORD=tu-contraseña-mysql-aqui
MYSQL_SSL_MODE=

# Contraseña de usuarios creados por: python manage.py seed_demo
SEED_DEMO_PASSWORD=Shori2024!

# PythonAnywhere (producción demo)
# PYTHONANYWHERE_DOMAIN=tuusuario.pythonanywhere.com
