# Copia este archivo como .env.local y sustituye los valores reales en tu entorno.
USE_SQLITE=false
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=shori_express
MYSQL_USER=root
MYSQL_PASSWORD=example_password
MYSQL_SSL_MODE=DISABLED